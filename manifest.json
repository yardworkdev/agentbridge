{
  "manifest_version": 3,
  "name": "AgentBridge \u2014 Connect AI Agents to Your Browser",
  "version": "0.5.0",
  "description": "Local bridge so AI agents can read the active tab and clipboard and inject text \u2014 every action needs your approval.",
  "permissions": [
    "activeTab",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AgentBridge",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
